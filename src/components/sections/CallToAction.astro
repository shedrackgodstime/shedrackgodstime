---
/**
 * CallToAction — homepage closing section.
 *
 * Ported from the reference CallToAction.astro, rebuilt for the 9-role
 * token system. Uses Section/Container/Kicker/Button primitives and
 * surface-raised tokens. Last section, so no trailing divider.
 *
 * Per design-rules.md §1.3 this lives in components/sections/.
 */
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import Kicker from "../ui/Kicker.astro";
import Button from "../ui/Button.astro";
---

<Section variant="raised" divider={false}>
  <Container>
    <div class="max-w-card-cta">
      <Kicker mb="sm">Going Deeper</Kicker>
      <h2 class="m-0 mb-4 text-h2-cta leading-normal font-bold text-text">
        Want the full picture behind the work?
      </h2>
      <p
        class="m-0 mb-7 max-w-narrow text-text-muted text-subtitle-responsive leading-prose"
      >
        Background, experience, and credentials live on the About page. For
        technical discussion, research collaboration, or anything else — get in
        touch.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <Button href="/about">About &amp; Background</Button>
        <Button href="/contact" variant="ghost" mono>Get In Touch →</Button>
      </div>
    </div>
  </Container>
</Section>
