---
/**
 * Button — primary site button.
 *
 * Replaces the 4+ inline button skeletons (about.astro, 404.astro, hero, CTA)
 * and the legacy .btn-primary / .btn-ghost classes (now deleted from components.css).
 *
 * Variants:
 *   primary  — filled accent (CTA, submit)
 *   ghost    — outlined (secondary action)
 *   link     — inline text with underline-on-hover
 *
 * Renders <a> when `href` is provided, <button> otherwise.
 * Per design-rules.md §1.7 — variants enumerated once, in one object, in one file.
 */
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "ghost" | "link";
type Size = "md" | "sm";

interface BaseProps {
  variant?: Variant;
  size?: Size;
  /** Optional monospace font (e.g. footer links) */
  mono?: boolean;
  class?: string;
}

interface LinkProps extends BaseProps, Omit<HTMLAttributes<"a">, "class"> {
  href: string;
}

interface ButtonProps extends BaseProps, Omit<HTMLAttributes<"button">, "class"> {
  href?: never;
}

type Props = LinkProps | ButtonProps;

const {
  variant = "primary",
  size = "md",
  mono = false,
  class: className = "",
  ...rest
} = Astro.props as Props;

const base =
  "inline-flex items-center justify-center font-bold text-button border transition-colors duration-fast";

const variantClass = {
  primary:
    "bg-accent-fill text-on-accent   border-accent-fill-hover-soft hover:border-accent hover:bg-accent-fill-hover",
  ghost:
    "text-text   border-accent-fill-hover-soft hover:border-accent hover:text-accent-fill-hover",
  link:
    "text-text-muted border-transparent bg-transparent p-0 min-h-0 hover:text-accent",
}[variant];

const sizeClass =
  variant === "link"
    ? ""
    : {
        md: "min-h-button px-4.5 py-3",
        sm: "min-h-nav-link py-2.5 px-3",
      }[size];

const fontClass = mono ? "font-mono" : "";

const Tag = "href" in rest && rest.href ? "a" : "button";
const ariaLabel = (rest as { "aria-label"?: string })["aria-label"];
---

<Tag
  class:list={[base, variantClass, sizeClass, fontClass, className]}
  aria-label={ariaLabel}
  {...rest as HTMLAttributes<"a"> & HTMLAttributes<"button">}
>
  <slot />
</Tag>
