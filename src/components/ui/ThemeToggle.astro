---
/**
 * ThemeToggle — dark/light switch.
 *
 * Replaces the inline ThemeToggle. The icon swap is pure CSS (driven by
 * the `.theme-toggle` class + `.theme-icon-light` / `.theme-icon-dark`
 * children in components.css), so there is no client-side icon state.
 *
 * The no-flash bootstrap (toggling `.dark` on <html> before paint) must
 * remain inline in the layout's <head>; this primitive only owns the
 * click handler. See utils/theme.ts → initThemeToggle().
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---
<button
  type="button"
  aria-label="Toggle color theme"
  class:list={[
    "theme-toggle",
    "size-icon-button items-center justify-center text-text-faint hover:text-accent-fill-hover transition-colors shrink-0 cursor-pointer",
    className,
  ]}
>
  <svg
    class="theme-icon-dark"
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg
    class="theme-icon-light"
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
</button>
<script>
  import { initThemeToggle } from "../../utils/theme";
  initThemeToggle();
</script>
