---
/**
 * Design-system primitives.
 *
 * Every primitive in this directory is a pure structural component
 * that consumes tokens from src/styles/tokens.css. They contain no
 * business logic, no site content, and no per-page styling decisions.
 *
 * Per design-rules.md §1.3: ui/ knows nothing about the site. If a
 * component references a page, project, or section by name, it
 * belongs in components/sections/ instead.
 */
export { default as Container } from "./Container.astro";
export { default as Section } from "./Section.astro";
export { default as PageHeader } from "./PageHeader.astro";
export { default as Button } from "./Button.astro";
export { default as Heading } from "./Heading.astro";
export { default as Lede } from "./Lede.astro";
export { default as Tag } from "./Tag.astro";
export { default as StatusDot } from "./StatusDot.astro";
export { default as Kicker } from "./Kicker.astro";
export { default as NavLink } from "./NavLink.astro";
export { default as SocialLinks } from "./SocialLinks.astro";
export { default as ThemeToggle } from "./ThemeToggle.astro";
export { default as EntryCard } from "./EntryCard.astro";
export { default as CTACard } from "./CTACard.astro";
export { default as Breadcrumb } from "./Breadcrumb.astro";
---
